generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizerRole {
  owner
  admin
  staff
  scanner
}

enum OrganizerInvitationStatus {
  pending
  accepted
  revoked
}

enum EventVisibility {
  draft
  published
  hidden
}

enum OrderStatus {
  pending
  reserved
  paid
  failed
  canceled
  expired
  refunded
  paid_no_stock
}

enum LatePaymentCaseStatus {
  PENDING
  ACCEPTED
  REJECTED
  REFUND_REQUESTED
  REFUNDED
}

enum TicketStatus {
  issued
  void
  checked_in
}

enum DomainEventType {
  ORDER_RESERVED
  ORDER_PAID
  TICKETS_ISSUED
  TICKET_CHECKED_IN
  ORDER_CONFIRMATION_EMAIL_SENT
  ORDER_EXPIRED
  INVENTORY_RESERVATION_RELEASED
  RESERVATION_EXPIRED
  INVENTORY_RELEASED
  LATE_PAYMENT_DETECTED
  LATE_PAYMENT_CASE_CREATED
  LATE_PAYMENT_CASE_RESOLVED
  PAYMENT_MARKED_FAILED
  PAYMENT_MARKED_REFUNDED
  PAYMENT_MARKED_NO_STOCK
  MANUAL_OVERRIDE_EXECUTED
}

enum DomainActorType {
  user
  system
  worker
  webhook
}

enum DomainAggregateType {
  order
  ticket
  inventory_reservation
  event
  notification
}

enum PaymentProviderEventStatus {
  received
  processing
  processed
  deduped
  invalid
  error
}

enum PaymentIdempotencyStatus {
  in_progress
  completed
  failed
}

enum ArtistStatus {
  active
  inactive
}

enum VenueType {
  theater
  stadium
  arena
  club
  general_admission
  mixed
}

enum VenueStatus {
  active
  inactive
}

enum VenueLayoutMode {
  seated
  ga
  mixed
}

enum LayoutEntityType {
  zone
  seat
}

model User {
  id                          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                       String                 @unique
  passwordHash                String
  createdAt                   DateTime               @default(now()) @db.Timestamp(6)
  memberships                 Membership[]
  createdOrganizerInvitations OrganizerInvitation[]  @relation("OrganizerInvitationCreatedBy")
  acceptedOrganizerInvitations OrganizerInvitation[] @relation("OrganizerInvitationAcceptedBy")
  revokedOrganizerInvitations OrganizerInvitation[]  @relation("OrganizerInvitationRevokedBy")
  orders                      Order[]
  scans                       TicketScan[]
  createdVenueLayoutVersions  VenueLayoutVersion[]   @relation("VenueLayoutVersionCreatedBy")
  createdEventLayoutSnapshots EventLayoutSnapshot[]  @relation("EventLayoutSnapshotCreatedBy")
  createdEventLayoutInventoryBindings EventLayoutInventoryBinding[] @relation("EventLayoutInventoryBindingCreatedBy")

  @@index([createdAt])
}

model Organizer {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  slug          String                @unique
  createdAt     DateTime              @default(now()) @db.Timestamp(6)
  memberships   Membership[]
  invitations   OrganizerInvitation[]
  events        Event[]
  orders        Order[]
  venues        Venue[]
  serviceFeeBps Int                   @default(0)
  taxBps        Int                   @default(0)

  @@index([createdAt])
}

model Membership {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                 @db.Uuid
  organizerId          String                 @db.Uuid
  role                 OrganizerRole
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organizer            Organizer              @relation(fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedInvitations  OrganizerInvitation[]

  @@unique([userId, organizerId])
  @@index([organizerId, role])
}

model OrganizerInvitation {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId      String                    @db.Uuid
  email            String
  emailCanonical   String
  role             OrganizerRole
  status           OrganizerInvitationStatus @default(pending)
  tokenHash        String
  expiresAt        DateTime
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  createdByUserId  String                    @db.Uuid
  acceptedAt       DateTime?
  acceptedByUserId String?                   @db.Uuid
  revokedAt        DateTime?
  revokedByUserId  String?                   @db.Uuid
  membershipId     String?                   @db.Uuid
  organizer        Organizer                 @relation(fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser    User                      @relation("OrganizerInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedByUser   User?                     @relation("OrganizerInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revokedByUser    User?                     @relation("OrganizerInvitationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership       Membership?               @relation(fields: [membershipId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizerId, status, createdAt])
  @@index([emailCanonical, status, createdAt])
  @@index([expiresAt, status])
  @@index([tokenHash])
}

model Event {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId String          @db.Uuid
  name        String
  slug        String
  description String?
  venue       String?
  timezone    String
  startsAt    DateTime        @db.Timestamp(6)
  endsAt      DateTime        @db.Timestamp(6)
  visibility  EventVisibility @default(draft)
  capacity    Int
  createdAt   DateTime        @default(now()) @db.Timestamp(6)
  organizer   Organizer       @relation(fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticketTypes TicketType[]
  orders      Order[]
  tickets     Ticket[]
  scans       TicketScan[]
  eventArtists EventArtist[]
  layoutSnapshot EventLayoutSnapshot?
  layoutInventoryBindings EventLayoutInventoryBinding[]

  @@unique([organizerId, slug])
  @@index([organizerId, visibility])
  @@index([startsAt])
}

model Artist {
  id                String        @id @default(uuid()) @db.Uuid
  slug              String        @unique
  displayName       String
  legalOrFullName   String?
  shortBio          String?
  profileImageUrl   String?
  genreTagsJson     Json?
  externalLinksJson Json?
  status            ArtistStatus  @default(active)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  eventArtists      EventArtist[]

  @@index([status, createdAt])
  @@index([displayName])
}

model Venue {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId  String                @db.Uuid
  name         String
  slug         String
  venueType    VenueType
  locationJson Json?
  status       VenueStatus           @default(active)
  createdAt    DateTime              @default(now()) @db.Timestamp(6)
  updatedAt    DateTime              @updatedAt @db.Timestamp(6)
  organizer    Organizer             @relation(fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  templates    VenueLayoutTemplate[]
  snapshots    EventLayoutSnapshot[]

  @@unique([organizerId, slug])
  @@index([organizerId, status, createdAt])
}

model VenueLayoutTemplate {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId     String                @db.Uuid
  name        String
  description String?
  layoutMode  VenueLayoutMode
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now()) @db.Timestamp(6)
  updatedAt   DateTime              @updatedAt @db.Timestamp(6)
  venue       Venue                 @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions    VenueLayoutVersion[]
  snapshots   EventLayoutSnapshot[]

  @@index([venueId, isActive, createdAt])
}

model VenueLayoutVersion {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId      String                @db.Uuid
  versionNumber   Int
  schemaVersion   String
  layoutData      Json
  layoutHash      String
  publishedAt     DateTime              @db.Timestamp(6)
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamp(6)
  template        VenueLayoutTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User                  @relation("VenueLayoutVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  snapshots       EventLayoutSnapshot[]

  @@unique([templateId, versionNumber])
  @@index([templateId, publishedAt, createdAt])
}

model EventLayoutSnapshot {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId         String              @unique @db.Uuid
  venueId         String              @db.Uuid
  templateId      String              @db.Uuid
  layoutVersionId String              @db.Uuid
  snapshotData    Json
  snapshotHash    String
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now()) @db.Timestamp(6)
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  venue           Venue               @relation(fields: [venueId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  template        VenueLayoutTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  layoutVersion   VenueLayoutVersion  @relation(fields: [layoutVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser   User                @relation("EventLayoutSnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inventoryBindings EventLayoutInventoryBinding[]

  @@index([venueId, createdAt])
  @@index([templateId, createdAt])
  @@index([layoutVersionId, createdAt])
}

model EventArtist {
  id           String   @id @default(uuid()) @db.Uuid
  eventId      String   @db.Uuid
  artistId     String   @db.Uuid
  billingOrder Int?
  billingLabel String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  artist       Artist   @relation(fields: [artistId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([eventId, artistId])
  @@index([eventId, billingOrder])
  @@index([artistId])
  @@index([eventId, isPrimary])
}

model TicketType {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String                 @db.Uuid
  name           String
  priceCents     Int
  currency       String
  quota          Int
  salesStart     DateTime?              @db.Timestamp(6)
  salesEnd       DateTime?              @db.Timestamp(6)
  maxPerOrder    Int                    @default(10)
  requiredFields Json?
  remaining      Int                    @default(0)
  createdAt      DateTime               @default(now()) @db.Timestamp(6)
  event          Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems     OrderItem[]
  reservations   InventoryReservation[]
  tickets        Ticket[]
  layoutInventoryBindings EventLayoutInventoryBinding[]

  @@index([eventId])
  @@index([eventId, salesStart, salesEnd])
}

model Order {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId                String                 @db.Uuid
  eventId                    String                 @db.Uuid
  userId                     String?                @db.Uuid
  orderNumber                String                 @unique
  customerEmail              String
  status                     OrderStatus            @default(pending)
  subtotalCents              Int                    @default(0)
  feeCents                   Int                    @default(0)
  taxCents                   Int                    @default(0)
  totalCents                 Int                    @default(0)
  reservedUntil              DateTime?              @db.Timestamp(6)
  createdAt                  DateTime               @default(now()) @db.Timestamp(6)
  updatedAt                  DateTime               @updatedAt
  organizer                  Organizer              @relation(fields: [organizerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event                      Event                  @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user                       User?                  @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items                      OrderItem[]
  tickets                    Ticket[]
  payments                   Payment[]
  paymentEvents              PaymentEvent[]
  reservations               InventoryReservation[]
  emailEvents                EmailEvent[]
  latePaymentCases           LatePaymentCase[]
  paymentProviderEvents      PaymentProviderEvent[]
  paymentIdempotencyKeys     PaymentIdempotencyKey[]
  reserveIdempotencyKeys     ReserveIdempotencyKey[]
  confirmIdempotencyKeys     ConfirmIdempotencyKey[]
  latePaymentReviewRequired  Boolean                @default(false)
  confirmationEmailSentAt    DateTime?
  confirmationEmailMessageId String?

  @@index([organizerId, status, createdAt])
  @@index([eventId, status])
  @@index([reservedUntil, status])
}

model OrderItem {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String     @db.Uuid
  ticketTypeId   String     @db.Uuid
  quantity       Int
  unitPriceCents Int
  totalCents     Int
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticketType     TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketTypeId, orderId])
}

model Ticket {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String       @db.Uuid
  ticketTypeId String       @db.Uuid
  eventId      String       @db.Uuid
  status       TicketStatus @default(issued)
  code         String       @unique
  qrPayload    String
  issuedAt     DateTime     @default(now()) @db.Timestamp(6)
  checkedInAt  DateTime?    @db.Timestamp(6)
  checkedInBy  String?
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scans        TicketScan[]

  @@index([orderId])
  @@index([eventId, status])
}

model TicketScan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String   @db.Uuid
  eventId     String   @db.Uuid
  scannedById String?  @db.Uuid
  scannedAt   DateTime @default(now()) @db.Timestamp(6)
  result      String
  reason      String?
  gate        String?
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  scannedBy   User?    @relation(fields: [scannedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([eventId, scannedAt])
  @@index([ticketId, scannedAt])
}

model InventoryReservation {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String     @db.Uuid
  ticketTypeId String     @db.Uuid
  quantity     Int
  expiresAt    DateTime   @db.Timestamp(6)
  createdAt    DateTime   @default(now()) @db.Timestamp(6)
  releasedAt   DateTime?  @db.Timestamp(6)
  releaseReason String?
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketTypeId, expiresAt, releasedAt])
  @@index([orderId, releasedAt])
}

model EventLayoutInventoryBinding {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventLayoutSnapshotId String               @db.Uuid
  eventId               String               @db.Uuid
  ticketTypeId          String               @db.Uuid
  layoutEntityType      LayoutEntityType
  layoutEntityId        String
  capacityLimit         Int?
  isActive              Boolean              @default(true)
  createdByUserId       String               @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamp(6)
  updatedAt             DateTime             @updatedAt @db.Timestamp(6)
  eventLayoutSnapshot   EventLayoutSnapshot  @relation(fields: [eventLayoutSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  event                 Event                @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticketType            TicketType           @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser         User                 @relation("EventLayoutInventoryBindingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([eventLayoutSnapshotId, layoutEntityType, layoutEntityId, ticketTypeId])
  @@index([eventId, createdAt])
  @@index([eventLayoutSnapshotId, isActive, createdAt])
  @@index([ticketTypeId, createdAt])
}

model Payment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String            @db.Uuid
  provider         String
  providerRef      String
  status           String
  amountCents      Int
  createdAt        DateTime          @default(now()) @db.Timestamp(6)
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  latePaymentCases LatePaymentCase[]

  @@unique([provider, providerRef])
  @@index([orderId, createdAt])
}

model PaymentEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String
  providerEventId   String
  providerPaymentId String?
  eventType         String
  orderId           String?  @db.Uuid
  payloadJson       Json
  receivedAt        DateTime @default(now())
  processedAt       DateTime?
  processError      String?
  ignoredReason     String?
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@unique([provider, providerEventId])
  @@index([orderId])
  @@index([providerPaymentId])
  @@index([receivedAt])
  @@map("payment_events")
}

model ProcessedWebhookEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String
  externalEventId String
  processedAt     DateTime @default(now()) @db.Timestamp(6)

  @@unique([provider, externalEventId])
  @@index([processedAt])
}

model PaymentProviderEvent {
  id              String                     @id @default(uuid())
  provider        String
  providerEventId String
  orderId         String?                    @db.Uuid
  payloadHash     String
  status          PaymentProviderEventStatus @default(received)
  attempts        Int                        @default(0)
  leaseUntil      DateTime?
  lastAttemptAt   DateTime?
  receivedAt      DateTime                   @default(now())
  processedAt     DateTime?
  errorMessage    String?
  order           Order?                     @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([provider, providerEventId])
  @@index([status, leaseUntil])
  @@index([status, receivedAt])
  @@index([orderId, receivedAt])
}

model PaymentIdempotencyKey {
  id             String                   @id @default(uuid())
  provider       String
  idempotencyKey String
  orderId        String?                  @db.Uuid
  status         PaymentIdempotencyStatus @default(in_progress)
  createdAt      DateTime                 @default(now())
  completedAt    DateTime?
  order          Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([provider, idempotencyKey])
  @@index([status, createdAt])
  @@index([orderId, createdAt])
}

model LatePaymentCase {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt         DateTime              @default(now()) @db.Timestamp(6)
  updatedAt         DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  version           Int                   @default(0)
  orderId           String                @db.Uuid
  reserveId         String?               @db.Uuid
  provider          String
  providerPaymentId String?
  paymentAttemptId  String?               @db.Uuid
  inventoryReleased Boolean               @default(false)
  status            LatePaymentCaseStatus @default(PENDING)
  detectedAt        DateTime              @default(now()) @db.Timestamp(6)
  resolutionNotes   String?
  resolvedAt        DateTime?             @db.Timestamp(6)
  resolvedBy        String?
  order             Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  paymentAttempt    Payment?              @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([provider, providerPaymentId])
  @@unique([orderId, paymentAttemptId])
  @@index([orderId])
}

model EmailEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String?  @db.Uuid
  provider  String
  eventType String
  sgEventId String?
  messageId String?
  recipient String?
  payload   Json
  createdAt DateTime @default(now()) @db.Timestamp(6)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([provider, sgEventId])
  @@index([orderId, createdAt])
  @@index([provider, eventType, createdAt])
}

model DomainEvent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          DomainEventType
  version       Int                 @default(1)
  correlationId String?
  actorType     DomainActorType
  actorId       String?
  aggregateType DomainAggregateType
  aggregateId   String
  eventId       String?             @db.Uuid
  orderId       String?             @db.Uuid
  ticketId      String?             @db.Uuid
  organizerId   String?             @db.Uuid
  context       Json
  payload       Json
  occurredAt    DateTime            @default(now()) @db.Timestamp(6)

  @@index([eventId, occurredAt])
  @@index([organizerId, occurredAt])
  @@index([type, occurredAt])
  @@index([correlationId, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
}

model ReserveIdempotencyKey {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientRequestId String   @unique
  orderId         String?  @db.Uuid
  status          String   @default("completed")
  createdAt       DateTime @default(now())
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model ConfirmIdempotencyKey {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientRequestId  String   @unique
  orderId          String   @db.Uuid
  paymentReference String
  createdAt        DateTime @default(now())
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamp(6)

  @@index([organizerId, createdAt])
  @@index([entityType, entityId])
}
